{
  "displayName": "Reporium Production",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cloud Run: Request Count",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"reporium-api\" AND metric.type=\"run.googleapis.com/request_count\"",
                  "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_RATE","crossSeriesReducer": "REDUCE_SUM","groupByFields": ["metric.labels.response_code_class"]}
                }
              },
              "legendTemplate": "${metric.labels.response_code_class}"
            }]
          }
        }
      },
      {
        "xPos": 4,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cloud Run: Latency p50/p95/p99",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"reporium-api\" AND metric.type=\"run.googleapis.com/request_latencies\"",
                    "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_PERCENTILE_50","crossSeriesReducer": "REDUCE_MAX","groupByFields": []}
                  }
                },
                "legendTemplate": "p50"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"reporium-api\" AND metric.type=\"run.googleapis.com/request_latencies\"",
                    "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_PERCENTILE_95","crossSeriesReducer": "REDUCE_MAX","groupByFields": []}
                  }
                },
                "legendTemplate": "p95"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"reporium-api\" AND metric.type=\"run.googleapis.com/request_latencies\"",
                    "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_PERCENTILE_99","crossSeriesReducer": "REDUCE_MAX","groupByFields": []}
                  }
                },
                "legendTemplate": "p99"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cloud Run: Instance Count",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"reporium-api\" AND metric.type=\"run.googleapis.com/container/instance_count\"",
                  "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_MEAN","crossSeriesReducer": "REDUCE_SUM","groupByFields": []}
                }
              },
              "legendTemplate": "instances"
            }]
          }
        }
      },
      {
        "yPos": 4,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cloud SQL: CPU Utilization",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"perditio-platform:reporium-db\" AND metric.type=\"cloudsql.googleapis.com/database/cpu/utilization\"",
                  "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_MEAN","crossSeriesReducer": "REDUCE_MAX","groupByFields": []}
                }
              },
              "legendTemplate": "CPU %"
            }]
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 4,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cloud SQL: Active Connections",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"perditio-platform:reporium-db\" AND metric.type=\"cloudsql.googleapis.com/database/postgresql/num_backends\"",
                  "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_MEAN","crossSeriesReducer": "REDUCE_MAX","groupByFields": []}
                }
              },
              "legendTemplate": "connections"
            }]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 4,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Cloud SQL: Memory + Disk",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"perditio-platform:reporium-db\" AND metric.type=\"cloudsql.googleapis.com/database/memory/utilization\"",
                    "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_MEAN","crossSeriesReducer": "REDUCE_MAX","groupByFields": []}
                  }
                },
                "legendTemplate": "memory %"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"perditio-platform:reporium-db\" AND metric.type=\"cloudsql.googleapis.com/database/disk/utilization\"",
                    "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_MEAN","crossSeriesReducer": "REDUCE_MAX","groupByFields": []}
                  }
                },
                "legendTemplate": "disk %"
              }
            ]
          }
        }
      },
      {
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Uptime Check Pass Rate",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"uptime_url\" AND metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\"",
                  "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_FRACTION_TRUE","crossSeriesReducer": "REDUCE_MEAN","groupByFields": ["resource.labels.host"]}
                }
              },
              "legendTemplate": "${resource.labels.host}"
            }]
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Cloud Run: 5xx Error Rate",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"reporium-api\" AND metric.type=\"run.googleapis.com/request_count\" AND metric.labels.response_code_class=\"5xx\"",
                  "aggregation": {"alignmentPeriod": "60s","perSeriesAligner": "ALIGN_RATE","crossSeriesReducer": "REDUCE_SUM","groupByFields": []}
                }
              },
              "legendTemplate": "5xx/s"
            }]
          }
        }
      }
    ]
  }
}
